// Пример 06-03. Паника — для ошибок программиста, Result — для ожидаемых ошибок
// Проверяет: assert, unreachable, unwrap, выход за границы, тип Never.

fun average(values: Slice<Int>): Float64 {
    assert(values.isNotEmpty(), "average: пустой список — ошибка вызывающего кода")
    return values.sum().toFloat64() / values.len().toFloat64()
}

fun weekday(n: Int): String = match n {
    1 -> "понедельник"
    2 -> "вторник"
    3 -> "среда"
    4 -> "четверг"
    5 -> "пятница"
    6 -> "суббота"
    7 -> "воскресенье"
    _ -> unreachable("номер дня проверяется при вводе")     // Never подходит к String
}

fun main() {
    val data = [3, 5, 10]
    println(average(data))                // 6.0
    println(weekday(3))

    val third = data[2]                   // проверка границ: при выходе — паника, а не чтение чужой памяти
    val missing = data.get(10)            // безопасная альтернатива: null
    println("{third} {missing}")

    val port = "80".parseInt().unwrap()   // unwrap уместен, когда ошибка невозможна по смыслу
    println(port)
    // В MVP паника завершает процесс (ADR-0007). Перехват паники на границе потока
    // для серверов — решение до этапа 3 (Q-12).
}
