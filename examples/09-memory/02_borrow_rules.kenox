// Пример 09-02. Правила заимствований
// Проверяет: «много читателей или один писатель», запрет псевдонимов для inout,
// окончание заимствования после последнего использования, двухфазные заимствования.

fun transfer(inout from: Int, inout to: Int, amount: Int) {
    from -= amount
    to += amount
}

fun main() {
    var a = 100
    var b = 20
    transfer(&a, &b, 30)
    // ✗ transfer(&a, &a, 10)
    //   ошибка: `a` передана как inout дважды — два исключительных заимствования одного места

    var scores = [3, 1, 2]
    val first = ref scores[0]               // заимствование для чтения
    println(first)
    scores.push(4)                          // можно: `first` больше не используется

    val second = ref scores[1]
    // ✗ scores.clear()
    //   ошибка: scores изменяется, пока `second` заимствует её элемент (используется ниже)
    println(second)

    scores.push(scores.len())               // двухфазное заимствование: len() вычисляется до изменения

    var grid = [[1, 2], [3, 4]]
    // ✗ transfer(&grid[0][0], &grid[0][1], 1)
    //   ошибка: два исключительных заимствования одной коллекции — компилятор не различает индексы
    // ⚠ Р-19: чтобы изменить два элемента сразу, нужен метод вроде splitAt или swap
    grid[0].swap(0, 1)
    println(grid)                           // [[2, 1], [3, 4]]
}
