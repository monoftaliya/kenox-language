// Пример 04-04. Расширения чужих типов
// Проверяет: extend Тип { } для методов-расширений, непрозрачный тип результата,
// свой трейт для чужого типа, приоритет собственных методов над расширениями.

extend str {
    fun isBlank(self): Bool = self.trim().isEmpty()

    // Итератор заимствует строку; зависимость от self выводится.
    fun words(self): some Iterator<str> = self.split(' ').filter { it.isNotEmpty() }
    // ⚠ Р-10: по исходному правилу вернуть List<str> было нельзя — коллекция не могла хранить
    //   заимствования. Принята «условная невыходящесть» (Q-40): List<str> разрешён, но сам
    //   становится невыходящим значением
    // ⚠ Р-11: без `some` пришлось бы назвать тип Filter<Split, …> с типом замыкания внутри
}

trait Summary {
    fun summary(self): String
}

extend List<Int>: Summary {                 // свой трейт для чужого типа — разрешено
    fun summary(self): String = "чисел: {self.len()}, сумма: {self.sum()}"
}

extend String {
    fun len(self): Int = 0                  // предупреждение: у String уже есть метод len —
                                            // собственный метод типа важнее расширения,
                                            // это расширение никогда не будет вызвано
}

fun main() {
    println("   ".isBlank())                            // true
    for w in "раз  два   три".words() { println(w) }
    println([3, 4, 5].summary())                         // чисел: 3, сумма: 12
    println("кот".len())                                 // 6 байт: вызван собственный метод String
    // В библиотеке `extend List<Int>: Show` было бы ошибкой (правило «сироты»: и трейт,
    // и тип чужие). В конечном приложении это предлагается разрешить (Q-13).
}
