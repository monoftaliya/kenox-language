// Пример 04-01. Трейты: контракт, реализация по умолчанию, статические функции
// Проверяет: обязательные методы и методы по умолчанию, extend T: Trait,
// переопределение метода по умолчанию, ограничения в обобщённых функциях.

import std.ops.Add                                  // трейт операции +; в прелюдию не входит

trait Shape {
    fun area(self): Float64
    fun perimeter(self): Float64

    fun describe(self): String =                    // реализация по умолчанию
        "площадь {self.area():.2}, периметр {self.perimeter():.2}"
}

struct Circle { radius: Float64 }
struct Rect { width: Float64, height: Float64 }

extend Circle: Shape {
    fun area(self): Float64 = Float64.PI * self.radius * self.radius
    fun perimeter(self): Float64 = 2.0 * Float64.PI * self.radius
}

extend Rect: Shape {
    fun area(self): Float64 = self.width * self.height
    fun perimeter(self): Float64 = 2.0 * (self.width + self.height)
    fun describe(self): String = "прямоугольник {self.width}×{self.height}"   // своя версия
}

trait Zero {
    fun zero(): Self                                // статическая функция трейта
}
extend Int: Zero { fun zero(): Int = 0 }
extend Float64: Zero { fun zero(): Float64 = 0.0 }

fun totalArea<T: Shape>(shapes: Slice<T>): Float64 {
    var sum = 0.0
    for s in shapes { sum += s.area() }
    return sum
}

fun sumAll<T: Zero + Add + Copy>(values: Slice<T>): T {
    var acc = T.zero()
    for v in values { acc = acc + v }
    return acc
}

fun main() {
    val circles = [Circle(radius = 1.0), Circle(radius = 2.0)]
    println(totalArea(circles))
    println(circles[0].describe())
    println(Rect(width = 2.0, height = 3.0).describe())
    println(sumAll([1, 2, 3]))                      // 6
    println(sumAll([0.5, 0.25]))                    // 0.75
    // ✗ extend Circle: Shape { fun area(self): Float64 = 1.0 }
    //   ошибка: не реализован обязательный метод perimeter (и Circle уже реализует Shape выше)
}
